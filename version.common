    echo "$(vcs_version riscv-gnu-toolchain/gcc) - GCC"
    echo "$(vcs_version riscv-gnu-toolchain/glibc) - glibc"
    echo "$2"
  } >"${VER_DIR}/riscv64-unknown-linux-gnu-toolchain"
}


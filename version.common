#!/usr/bin/bash

vcs_version() {
  pushd "$1" >/dev/null 2>&1 || return 255
  local git_ver
  local git_remote_url
  git_ver=$(git rev-parse --short=7 HEAD)
  git_remote_url=$(git config --get remote.origin.url)
  if [ -z "$(git status --untracked-files=no --porcelain)" ]; then
    echo "${git_ver} @ ${git_remote_url}"
  else
    echo "${git_ver}-dirty @ ${git_remote_url}"
  fi
  popd >/dev/null 2>&1 || return 255
}

log_newlib_toolchain_version_to() {
  local VER_DIR="$1/version"
  mkdir -p "${VER_DIR}"
  {
    echo "$(vcs_version riscv-gnu-toolchain) - Toolchain"
    echo "$(vcs_version riscv-gnu-toolchain/binutils) - Binutils"
    echo "$(vcs_version riscv-gnu-toolchain/gcc) - GCC"
    echo "$(vcs_version riscv-gnu-toolchain/newlib) - Newlib"
    echo "$2"
  } >"${VER_DIR}/riscv64-unknown-elf-toolchain"
}

log_linux_toolchain_version_to() {

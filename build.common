#!/usr/bin/bash

# This file uses source code from the University of Berkeley RISC-V project
# in original or modified form.
# Please see LICENSE for details.

# Script to build RISC-V ISA simulator, proxy kernel, and GNU toolchain.

JOBS=$(nproc)

if [ -z "${RISCV_INSTALL}" ]; then
  echo "Please set the RISCV_INSTALL environment variable to your preferred install path."
  exit 1
fi

# Prefer gmake over make if exists.
MAKE=$(command -v gmake || command -v make)

PATH="${RISCV_INSTALL}/bin:${PATH}"

clean_gcc_linux() {
  if [ -e "$1/build_linux" ]; then
    echo "Removing existing $1/build_linux directory"
    rm -rf "$1/build_linux"
  fi
}

clean_gcc_newlib() {
  if [ -e "$1/build_newlib" ]; then
    echo "Removing existing $1/build_newlib directory"
    rm -rf "$1/build_newlib"
  fi
}

clean_project() {
  if [ -e "$1/build" ]; then
    echo "Removing existing $1/build directory"
    rm -rf "$1/build"
  fi
}

backup_file() {
  local filename="$1"
  local backup_id=0
  local backup_filename="${filename}.$((backup_id++))"

  while [ -e "${backup_filename}" ]; do
    backup_filename="${filename}.$((backup_id++))"
  done
  [ -e "${filename}" ] && mv "${filename}" "${backup_filename}"
  return 0
}

init_log_file() {
  local log_filename="$1"
  backup_file "${log_filename}"
  {
    printf "%0.s==========" {1..8}
    echo
    echo "Logged at $(date)"
    printf "%0.s==========" {1..8}
    echo
  } >"${log_filename}"
}

build_project() {
  local pname="$1"
  shift

  local run_configure="no"
  if [ ! -e "${pname}/build" ]; then
    mkdir -p "${pname}/build"
    run_configure="yes"
  fi

  if [ ! -x "${pname}/configure" ]; then
    echo "Build ${pname} for the first time, bootstrap the autotools project via \"${pname}/scripts/autogen.sh\""
    "${pname}/scripts/autogen.sh"
    echo "Autotools project initialized"
    echo
  fi

  echo "Starting ${pname} build process"
  pushd "${pname}/build" >/dev/null || return 255
  init_log_file build.log
  echo "(Log can be found at $PWD/build.log)"

  if [ "${run_configure}" = "yes" ]; then
    echo "Configuring project ${pname}"
    ../configure "$@" >>build.log 2>&1
  fi
  echo "Building project ${pname}"
  $MAKE "-j${JOBS}" >>build.log 2>&1
  echo "Installing project ${pname}"
  $MAKE "-j${JOBS}" install >>build.log 2>&1
  popd >/dev/null || return 255
  echo "Project ${pname} installation completed!"
  echo
}

build_gcc_linux() {
  local pname="$1"
  shift
  echo "Starting RISC-V GNU Toolchain (Linux) build process"
  local run_configure="no"
  if [ ! -e "${pname}/build_linux" ]; then
    mkdir -p "${pname}/build_linux"
    run_configure="yes"
  fi
  pushd "${pname}/build_linux" >/dev/null || return 255

  init_log_file build.log
  echo "(Log can be found at $PWD/build.log)"

  if [ "${run_configure}" = "yes" ]; then
    echo "Configuring project ${pname}"
    ../configure "$@" >>build.log 2>&1
  fi
  echo "Building project ${pname}"
  $MAKE "-j${JOBS}" linux >>build.log 2>&1
  echo "Installing project ${pname}"
  $MAKE "-j${JOBS}" install >>build.log 2>&1
  popd >/dev/null || return 255
  echo "RISC-V GNU Toolchain (Linux) installation completed!"
}

build_gcc_newlib() {
  local pname="$1"
  shift
  echo "Starting RISC-V GNU Toolchain (Newlib) build process"

  local run_configure="no"
  if [ ! -e "${pname}/build_newlib" ]; then
    mkdir -p "${pname}/build_newlib"
    run_configure="yes"
  fi
  pushd "${pname}/build_newlib" >/dev/null || return 255

  init_log_file build.log
  echo "(Log can be found at $PWD/build.log)"

  if [ "${run_configure}" = "yes" ]; then
    echo "Configuring project ${pname}"
    ../configure "$@" >build.log 2>&1
  fi
  echo "Building project ${pname}"
  $MAKE "-j${JOBS}" newlib >>build.log 2>&1
  echo "Installing project ${pname}"
  $MAKE "-j${JOBS}" install >>build.log 2>&1
  popd >/dev/null || return 255
  echo "RISC-V GNU Toolchain (Newlib) installation completed!"
}

check_newlib_gcc() {
  if ! command -v riscv64-unknown-elf-gcc >/dev/null 2>&1; then
    echo "riscv64-unknown-elf-gcc doesn't appear to be installed; it is required for building the proxy kernel; use the build-gcc.sh to build and install it."
    exit 1
  fi
}
